# Copy this file to `.env` and adjust values. `.env` is gitignored.
# docker compose auto-loads `.env` from the project root.

# --- Anthropic (iteration 1) ---
ANTHROPIC_API_KEY=sk-ant-...        # required — the app won't start without it
# ANTHROPIC_MODEL=claude-sonnet-4-6 # optional; default lives in config.py

# --- Postgres credentials (used by the postgres service) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ragdb

# --- Connection URLs ---
# Hybrid dev mode: the API runs on the host and connects to the containers
# via the ports they publish on localhost.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ragdb
REDIS_URL=redis://localhost:6379/0

# NOTE: iteration 1 doesn't use the DB/Redis (kept here for later iterations).
# DATABASE_URL / REDIS_URL are optional until iteration 3 / 6.
