# Copy this file to `.env` and adjust values. `.env` is gitignored.
# docker compose auto-loads `.env` from the project root.

# --- Postgres credentials (used by the postgres service) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ragdb

# --- Connection URLs ---
# Hybrid dev mode: the API runs on the host and connects to the containers
# via the ports they publish on localhost.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ragdb
REDIS_URL=redis://localhost:6379/0

# NOTE: when the API runs *inside* compose (`docker compose --profile full up`),
# the compose file overrides these to use the service names (postgres / redis).
